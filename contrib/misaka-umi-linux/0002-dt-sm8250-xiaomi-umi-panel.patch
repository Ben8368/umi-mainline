+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * xiaomi-umi-panels.dtsi — 自动生成，别手改
+ *   生成: python tools/gen-panel-dts.py dump/panels \
+ *             -o dts/xiaomi-umi-panels.dtsi --enable qcom,mdss_dsi_j2_mp_42_02_0b_dsc_cmd
+ *
+ * 数据全部来自设备自己的下游 DTB。驱动只认 "xiaomi,umi-panel"，
+ * 时序 / init 序列 / DSC 参数都从 DT 读 —— 换屏只改 --enable，不用改驱动。
+ *
+ * ★ 面板节点必须是 &mdss_dsi0 的子节点（reg = <0> 选虚拟通道 0），
+ *   否则 mipi_dsi 不会为它创建 mipi_dsi_device，驱动根本不会 probe。
+ * ★ 22 个变体不要同时塞进来：同一父节点下只能有一个 panel@0。
+ *   换屏 = 重新跑一次生成器 + dtb-only.sh（1 分钟，不用重编内核）。
+ */
+
+&mdss_dsi0 {
+	umi-panel@0 {
+		compatible = "xiaomi,umi-panel";
+		reg = <0>;
+		status = "okay";
