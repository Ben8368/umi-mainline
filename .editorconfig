# SPDX-License-Identifier: CC0-1.0
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_style = tab

[*.{dts,dtsi}]
indent_style = tab

[Makefile]
indent_style = tab

[*.ps1]
# Windows PowerShell 5.1 misreads a BOM-less .ps1 as ANSI, so keep these ASCII
# and do not force LF.
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false