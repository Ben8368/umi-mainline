// SPDX-License-Identifier: BSD-3-Clause
/*
 * Xiaomi Mi 10 (umi) - STMicroelectronics "FTS" touchscreen
 *
 * Where the numbers come from (read back from the live MIUI device):
 *   - address    : 0x49  (/sys/bus/i2c/devices/3-0049/name = fts)
 *   - SDA / SCL  : GPIO37 / GPIO36
 *   - reset      : GPIO38, active high (out of reset)
 *                  vendor: fts,reset-gpio = <&tlmm 0x26 0x00>
 *   - irq        : GPIO39, level low
 *                  vendor: fts,irq-gpio = <&tlmm 0x27 0x2008>
 *   - vdd  1.8 V : vreg_l1c_1p8   (vendor "pm8150a_l1", really ldoc1 = PM8150L LDO1)
 *   - avdd 3.3 V : touch_vddio_vreg (GPIO69 enable, declared in the common dtsi)
 *
 * �?Why the bus is bit-banged in the driver instead of being an i2c@ node
 *
 *   On a running MIUI the two bus pins report "function gpio", owned by
 *   a94000.i2c -- the vendor "i2c-geni" there is not driving the QUP at all.
 *   The SE has its FIFO interface disabled (GENI_IF_DISABLE_RO), so mainline
 *   geni-i2c has to use GPI DMA, and on this board GPI never answers
 *   EV ALLOCATE:
 *
 *       gpi a00000.dma-controller: cmd: EV ALLOCATE completion timeout:2
 *       geni_i2c a94000.i2c: error -ENODEV: Failed to setup GPI DMA mode
 *
 *   Going through the generic i2c-gpio driver then registered a bus but every
 *   transfer returned -ENXIO, because its open-drain path needs native
 *   open-drain support that pinctrl-msm does not implement.
 *
 *   So the driver owns the three pins and does the I2C itself (~100 kHz).  The
 *   QUP stack is left disabled so nothing else touches the pads.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/* --- pin states ---------------------------------------------------------- */

&tlmm {
	ts_i2c_pins: ts-i2c-pins-state {
		pins = "gpio36", "gpio37";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	/* Direction is driven by the driver: low for 20 ms, then released. */
	ts_reset_pins: ts-reset-pins-state {
		pins = "gpio38";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	ts_int_active: ts-int-active-state {
		pins = "gpio39";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		input-enable;
	};

	/* The vendor parks the interrupt line with a pull-down while the chip is
	 * asleep, so it cannot float high and keep the GIC armed. */
	ts_int_sleep: ts-int-sleep-state {
		pins = "gpio39";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		input-enable;
	};
};

/* --- keep the QUP stack out of the way ----------------------------------- */

&qupv3_id_1 {
	status = "disabled";
};

&gpi_dma1 {
	status = "disabled";
};

&i2c13 {
	status = "disabled";
};

/* --- the bus and the controller ----------------------------------------- */

/*
 * 主线 ST FTS5 驱动（sm7150-mainline 移植版，drivers/input/touchscreen/fts521�? * 是一份普�?i2c_driver，只�?i2c_transfer()。这里把两根线做成真正的
 * i2c_adapter（umi,i2c-bitbang），0x49 用子节点描述，驱动自�?probe�? *
 * 老的 st,fts-umi 平台驱动（自�?bit-bang、自己解析协议）保留在树里，
 * 但它和这份驱动不能同时占�?GPIO，所以同一�?config 里只能开一个�? */
/ {
	i2c_touch: i2c-touch {
		compatible = "umi,i2c-bitbang";
		#address-cells = <1>;
		#size-cells = <0>;

		/* 总线扫描定过：gpio36 = SDA，gpio37 = SCL */
		sda-gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
		scl-gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
		clock-frequency = <100000>;

		pinctrl-names = "default";
		pinctrl-0 = <&ts_i2c_pins &ts_int_active &ts_reset_pins>;

		touchscreen@49 {
			compatible = "st,fts";
			reg = <0x49>;

			interrupt-parent = <&tlmm>;
			interrupts = <39 IRQ_TYPE_LEVEL_LOW>;

			fts,irq-gpio = <&tlmm 39 GPIO_ACTIVE_LOW>;
			fts,reset-gpio = <&tlmm 38 GPIO_ACTIVE_HIGH>;
			fts,irq-flags = <8>;		/* IRQF_TRIGGER_LOW */

			/* Fixed rails, enable only, no voltage is programmed. */
			fts,regulator_dvdd = "vdd";
			fts,regulator_avdd = "avdd";
			vdd-supply = <&vreg_l1c_1p8>;
			avdd-supply = <&touch_vddio_vreg>;

			fts,x-max = <1080>;
			fts,y-max = <2340>;

			touchscreen-size-x = <1080>;
			touchscreen-size-y = <2340>;

			status = "okay";
		};
	};
};

/*
 * Touch 1.8 V rail (vendor: pm8150a_l1). Mainline has no PM8150A regulator
 * driver, so the reference driver enables it and always-on is the fallback.
 * Enable only, no voltage is programmed.
 */
&vreg_l1c_1p8 {
	regulator-always-on;
};
