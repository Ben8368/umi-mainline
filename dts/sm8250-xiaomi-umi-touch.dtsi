// SPDX-License-Identifier: BSD-3-Clause
/*
 * Xiaomi Mi 10 (umi) - STMicroelectronics "FTS" touchscreen
 *
 * This is the configuration that is verified working on this hardware (the
 * Armbian sm8250-xiaomi-umi port): the controller sits on GENI SE5
 * (i2c@a94000 == &i2c13) at 400 kHz, with the two bus pads muxed to the
 * "qup13" function exactly as the vendor stack leaves them.
 *
 * History: this used to be bit-banged from the driver because the SE has its
 * FIFO interface disabled (GENI_IF_DISABLE_RO) so mainline geni-i2c has to go
 * through GPI DMA, and GPI never answered EV ALLOCATE:
 *
 *     gpi a00000.dma-controller: cmd: EV ALLOCATE completion timeout:2
 *     geni_i2c a94000.i2c: error -ENODEV: Failed to setup GPI DMA mode
 *
 * A working tree on the same SoC proves the controller can be used, so this
 * file now just enables the standard QUP path.  patches/umi-i2c.c (the
 * bit-bang adapter) is still in the tree; it simply has no device node any
 * more, so nothing binds to it.
 *
 * The three pins the driver still owns:
 *   - reset : GPIO38, active high (out of reset)
 *             vendor: fts,reset-gpio = <&tlmm 0x26 0x00>
 *   - irq   : GPIO39, level low
 *             vendor: fts,irq-gpio = <&tlmm 0x27 0x2008>
 *
 * Supply mapping copied from the working DTS:
 *   vdd  (bus / IO)  -> touch_vddio_vreg   (GPIO69 gated rail)
 *   avdd (power)     -> vreg_l1c_1p8       (1.8 V)
 * The driver enables vdd first, then avdd, and only ever programs avdd, so
 * this is the order the working stack ends up with.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/* --- pin states ---------------------------------------------------------- */

/*
 * No bus pin state here on purpose: gpio36/gpio37 belong to the QUP now and
 * are described by qup_i2c13_default in sm8250.dtsi (function "qup13").
 * Claiming them with function "gpio" would put them back into the GPIO block
 * and the controller would no longer drive them.
 */
&tlmm {
	/* The vendor parks the interrupt line with a pull-down while the chip is
	 * asleep, so it cannot float high and keep the GIC armed. */
	ts_int_active: ts-int-active-state {
		pins = "gpio39";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		input-enable;
	};

	ts_int_sleep: ts-int-sleep-state {
		pins = "gpio39";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		input-enable;
	};
};

/* --- the QUP stack ------------------------------------------------------- */

&qupv3_id_1 {
	status = "okay";
};

/*
 * gpi_dma1 needs a non-zero EE register offset.
 *
 * sm8250 has two GPI DMA controllers whose EE registers do not sit at the
 * start of their register windows.  Newer mainline names the two variants
 * "qcom,sm8250-gpi-dma-0" (ee_offset 0x1000) and "qcom,sm8250-gpi-dma-1"
 * (ee_offset 0x6000); this tree (6.12.94) only carries the single
 * "qcom,sm8250-gpi-dma", whose match data is ee_offset 0.  With that offset
 * the driver computes a wrong ee_base for wrap1 and every GPI command goes
 * unanswered:
 *
 *     gpi a00000.dma-controller: cmd: EV ALLOCATE completion timeout:2
 *     gpi a00000.dma-controller: error alloc_ev_chan:-5
 *     geni_i2c a94000.i2c: error -ENODEV: Failed to setup GPI DMA mode
 *
 * The two match entries are added by scripts/build.sh, which patches
 * drivers/dma/qcom/gpi.c in the kernel tree before building.
 */
&gpi_dma1 {
	compatible = "qcom,sm8250-gpi-dma-1", "qcom,sdm845-gpi-dma";
	status = "okay";
};

/* --- the bus and the controller ----------------------------------------- */

&i2c13 {
	status = "okay";
	clock-frequency = <400000>;

	touchscreen@49 {
		compatible = "st,fts";
		reg = <0x49>;

		interrupt-parent = <&tlmm>;
		interrupts = <39 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		pinctrl-0 = <&ts_int_active>;
		pinctrl-1 = <&ts_int_sleep>;

		/*
		 * Supply mapping taken from MIUI, not from the other working DTS.
		 *
		 * On a running MIUI the regulator state is:
		 *   vreg_l1c_1p8     1800 mV  consumer 4900000003.touchscreen-vdd
		 *   touch_vddio_vreg 3300 mV  1 user
		 * so vdd (bus) is the 1.8 V PM8150L LDO and avdd (power) is the
		 * GPIO69 gated rail.  That also matches the vendor driver, which
		 * programs avdd with regulator_set_voltage(avdd, 3300000, 3300000).
		 *
		 * The other working tree has these two swapped; with avdd on the
		 * fixed 1.8 V rail that call fails and every raw sample comes back
		 * identical (-13462), i.e. the analogue front end never sees a
		 * valid acquisition.
		 */
		vdd-supply = <&vreg_l1c_1p8>;
		avdd-supply = <&touch_vddio_vreg>;
		fts,regulator_dvdd = "vdd";
		fts,regulator_avdd = "avdd";

		fts,irq-gpio = <&tlmm 39 GPIO_ACTIVE_LOW>;
		fts,irq-gpio-name = "fts_irq";
		fts,reset-gpio-enable;
		/*
		 * 两套属性并存：
		 *   fts,reset-gpio  6.12 的驱动自己解析（vendor 命名）
		 *   reset-gpios     7.x 的驱动用 devm_gpiod_get(dev, "reset") 取
		 */
		fts,reset-gpio = <&tlmm 38 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&tlmm 38 GPIO_ACTIVE_HIGH>;
		fts,reset-gpio-name = "fts_rst";
		fts,irq-flags = <8>;		/* IRQF_TRIGGER_LOW */

		fts,x-max = <1080>;
		fts,y-max = <2340>;

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2340>;

		status = "okay";
	};
};

/*
 * Touch 1.8 V rail (vendor: pm8150a_l1). Mainline has no PM8150A regulator
 * driver, so the reference driver enables it and always-on is the fallback.
 * Enable only, no voltage is programmed.
 */
&vreg_l1c_1p8 {
	regulator-always-on;
};
