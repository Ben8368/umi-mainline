# umi-later.config — 内核确认能启动之后再逐组打开的选项
#
# 用法（在 /root/linux 里）：
#   scripts/kconfig/merge_config.sh -m .config ../config/umi-later.config
#   make ARCH=arm64 olddefconfig && make -j$(nproc) Image.gz
#
# ★ 一次只开一组，开完上机验一次。组与组之间的失败原因会互相掩盖，
#   一起开等于又回到「黑屏，不知道是谁」。
#
# 打开顺序建议：A → C → B → D（A 最可能就是「关掉它才不挂」的那一个，
# 所以它也是第一个要验证「关着确实更稳」的）。

# ---- A. cpuidle（PSCI idle 状态） ----------------------------------------
# 打开前请先确认：cat /sys/devices/system/cpu/cpu0/cpuidle/state*/name
# 关着的时候这个目录不存在，开了之后应该有 WFI 和 1~2 个 power-collapse 状态。
# 如果打开后「跑到某处不动」，就把它关回去，然后只用 WFI：
#   CONFIG_ARM_PSCI_CPUIDLE=y
#   # 并在 cmdline 加：cpuidle.off=1   （二分时更好用的做法）
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y

# ---- B. SMMU 收紧（禁用 bypass） -----------------------------------------
# 打开前先在关着的时候把 dmesg 里所有 arm-smmu / iommu 相关行看一遍，
# 确认没有 "Unhandled context fault"。打开后如果 UFS/USB 探不到，就是有设备漏了 iommus。
# CONFIG_ARM_SMMU_DISABLE_BYPASS_BY_DEFAULT=y

# ---- C. CPU 电压/频率自适应 ----------------------------------------------
# CPR 会改写电压表。打开前先备份 dmesg 里 "cpu cpu0: ... OPP" 的基线，
# 打开后如果出现随机死机 / 温度异常，立刻关回去。
# CONFIG_QCOM_CPR=y
# CONFIG_ARM_QCOM_CPUFREQ_HW=y

# ---- D. 再往后的（显示/GPU/DSP，属于第二阶段） ---------------------------
# 这些不是「打开更省电」，而是「打开了才有功能」，但每一个都要求先有对应的
# 面板/固件/固件分区，所以放最后：
#   CONFIG_DRM_MSM=m            需要先有 umi 面板驱动 + 绕开 MIPI DSC bug
#   CONFIG_QCOM_Q6V5_PAS=y      adsp/cdsp，需要 firmware-name 指向真实固件
#   CONFIG_QCOM_LLCC=y          已经有了，不用动
#
# 到那时候记得同时把 umi.config 里的 `# CONFIG_DRM_MSM is not set` 那行去掉，
# 否则 merge_config.sh 会把它按 not set 处理、把这里的气泡掉（后合并的赢）。
